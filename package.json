    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/node": "^26.2.0",
    "@types/semver": "7.7.1",
    "@types/yauzl": "^3.4.0",
    "@whatsapp-cloudapi/emulator": "5.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prisma": "^6.19.3",
    "prisma-generator-plantuml-erd": "^1.7.1",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
