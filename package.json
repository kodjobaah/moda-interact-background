{
  "name": "worker-kwadwos-gpt",
  "version": "1.0.0",
  "description": "Moda Interact background workers",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:shopify": "vitest run tests/integration/shopify.service.integration.test.ts",
    "test:integration": "vitest run tests/integration",
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "start:shopify-event-worker": "node --import ./observability/shopify-event.mjs dist/entrypoints/shopify-event.js",
    "start:recovery-worker": "node --import ./observability/recovery.mjs dist/entrypoints/recovery.js",
    "start:messaging-worker": "node --import ./observability/messaging.mjs dist/entrypoints/messaging.js",
    "readiness:shopify-event-worker": "node dist/readiness.js moda-shopify-event-worker",
    "readiness:recovery-worker": "node dist/readiness.js moda-recovery-worker",
    "readiness:messaging-worker": "node dist/readiness.js moda-messaging-worker",
    "prisma:validate": "prisma validate --schema database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/groq": "^4.0.30",
    "@ai-sdk/openai": "^4.0.46",
    "@langchain/langgraph": "^1.4.12",
    "@modainteract/moda-interact-shared": "0.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.77",
    "bullmq": "^6.2.0",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "prisma-generator-plantuml-erd": "^1.7.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
