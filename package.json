    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.77",
    "bullmq": "^6.2.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "music-metadata": "^11.15.0",
    "openai": "^7.10.0",
    "parse5": "8.0.0",
    "semver": "7.8.5",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
