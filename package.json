{
  "name": "worker-kwadwos-gpt",
  "version": "1.0.0",
  "description": "Moda Interact background workers",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:shopify": "vitest run tests/integration/shopify.service.integration.test.ts",
    "test:arch035-woo-order-capture:unit": "vitest run tests/unit/events/woo-order-capture.test.ts tests/unit/workers/woo-order-capture.worker.test.ts tests/unit/runtime/entrypoint-isolation.test.ts",
    "test:arch035-woo-order-capture:redis": "node scripts/test-integration.mjs tests/integration/woo-order-capture.integration.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:arch036-woo-coupon-catalogue:postgres": "node scripts/test-integration.mjs tests/integration/woo-coupon-catalogue-reconciliation.integration.test.ts",
    "test:arch036-woo-coupon-dispatch:postgres": "node scripts/test-integration.mjs tests/integration/woo-coupon-dispatch-worker.integration.test.ts",
    "inspect:shop-discounts": "node scripts/inspect-shop-discounts.mjs",
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "start:shopify-event-worker": "node --import ./observability/shopify-event.mjs dist/entrypoints/shopify-event.js",
    "start:recovery-worker": "node --import ./observability/recovery.mjs dist/entrypoints/recovery.js",
    "start:messaging-worker": "node --import ./observability/messaging.mjs dist/entrypoints/messaging.js",
    "start:merchant-communications-worker": "node --import ./observability/merchant-communications.mjs dist/entrypoints/merchant-communications.js",
    "start:merchant-knowledge-worker": "node --import ./observability/merchant-knowledge.mjs dist/entrypoints/merchant-knowledge.js",
    "start:billing-worker": "node --import ./observability/billing.mjs dist/entrypoints/billing.js",
    "readiness:shopify-event-worker": "node dist/readiness.js moda-shopify-event-worker",
    "readiness:recovery-worker": "node dist/readiness.js moda-recovery-worker",
    "readiness:messaging-worker": "node dist/readiness.js moda-messaging-worker",
    "readiness:merchant-communications-worker": "node dist/readiness.js moda-merchant-communications-worker",
    "readiness:merchant-knowledge-worker": "node dist/readiness.js moda-merchant-knowledge-worker",
    "readiness:billing-worker": "node dist/readiness.js moda-billing-worker",
    "prisma:validate": "prisma validate --schema database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "test:arch029-store-category-translation-runtime": "node scripts/validate-arch029-store-category-translation-runtime.mjs",
    "test:arch029-store-category-translation-publication": "node scripts/validate-arch029-store-category-translation-publication.mjs",
    "test:arch031-merchant-pricing-translation-runtime": "vitest run tests/unit/domain/merchant-pricing-translation.test.ts tests/unit/services/merchant-pricing-translation tests/unit/services/merchant-pricing-translation-batch-submit.service.test.ts tests/unit/services/merchant-pricing-translation-batch-results.service.test.ts tests/unit/services/merchant-pricing-translation-runtime-wiring.test.ts tests/unit/services/merchant-pricing-translation-reconciliation.service.test.ts tests/unit/services/merchant-pricing-translation-batch-poll.service.test.ts",
    "test:arch040-recovery-conversation": "vitest run tests/unit/services/recovery-conversation",
    "test:arch040-recovery-conversation:postgres": "node scripts/test-integration.mjs tests/integration/recovery-conversation.services.integration.test.ts",
    "test:arch038-live-budgets": "node --experimental-strip-types --test scripts/test-arch038-live-budget-contract.mjs",
    "test:arch038-live-budgets:postgres": "tsx scripts/test-arch038-live-budget-postgres.ts",
    "test:arch040-background-runtime:postgres": "node scripts/test-integration.mjs tests/integration/recovery-human-dispatch.integration.test.ts tests/integration/recovery-follow-up-claim-races.integration.test.ts",
    "test:arch040-background-wiring": "vitest run tests/unit/services/recovery-conversation/background-wiring.test.ts tests/unit/services/recovery-conversation/start-human-command-dispatcher.test.ts tests/unit/services/conversation-turn-processor.service.test.ts tests/unit/services/conversation.service.test.ts tests/unit/services/inbound-whatsapp-audio.service.test.ts tests/unit/workers/whatsapp.worker.test.ts",
    "test:arch043-platform-configuration:postgres": "node scripts/test-integration.mjs tests/integration/platform-configuration-reader.integration.test.ts",
    "test:arch043-translation-revocation:postgres": "node scripts/test-integration.mjs tests/integration/arch043-support-translation-revocation.integration.test.ts",
    "test:arch040-moderation": "vitest run tests/unit/services/conversation-moderation",
    "test:arch040-moderation:postgres": "node scripts/test-integration.mjs tests/integration/conversation-moderation.integration.test.ts"
  },
